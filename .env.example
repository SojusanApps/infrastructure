# PostgreSQL

# The name of the database user
POSTGRES_USER=
# The password for the database user
POSTGRES_PASSWORD=
# The name of the database Keycloak will use (defaults to POSTGRES_USER if unset, but set it explicitly)
POSTGRES_DB=keycloak

# Keycloak

# The username of the keycloak bootstrap admin user (only used to create the first admin on a fresh database)
KC_BOOTSTRAP_ADMIN_USERNAME=
# The password of the keycloak bootstrap admin user
KC_BOOTSTRAP_ADMIN_PASSWORD=
# If enable the health-check endpoints in the keycloak
KC_HEALTH_ENABLED=true
# The name of the database provider for the keycloak (we are using our PostgreSQL database from the container)
KC_DB=postgres
# The URL connection to the keycloak database (db is the compose service name; keep the db name in sync with POSTGRES_DB)
KC_DB_URL=jdbc:postgresql://db:5432/keycloak
# The name of the user that keycloak will use to connect into the database (same value as POSTGRES_USER)
KC_DB_USERNAME=
# The password of the user that keycloak will use to connect into the database (same value as POSTGRES_PASSWORD)
KC_DB_PASSWORD=
# The list of features that will be enabled
# KC_FEATURES=
# The public hostname Keycloak is served on in production, e.g. auth.example.com (ignored by `start-dev`)
KC_HOSTNAME=
# Reject requests that don't match KC_HOSTNAME once set (production only)
KC_HOSTNAME_STRICT=true
# Keycloak stays on plain HTTP internally; the reverse proxy on the same host terminates TLS
KC_HTTP_ENABLED=true
# Trust X-Forwarded-* headers from the reverse proxy
KC_PROXY_HEADERS=xforwarded

# Keycloak app (realm-export.json)

# The ClientId for the Google OAuth provider
PROVIDER_GOOGLE_ID=
# The ClientSecret for the Google OAuth provider
PROVIDER_GOOGLE_SECRET=

# Deletion Broker (RabbitMQ) - see docs/adr/0003-shared-rabbitmq-broker-for-user-deletion-propagation.md

# Password for the "operator" management/admin user (full access, for operators only)
RABBITMQ_ADMIN_PASSWORD=
# Password for the "keycloak-deletion-publisher" user (write-only on the user-deletion exchange)
RABBITMQ_KEYCLOAK_PUBLISHER_PASSWORD=
# Password for the "gamelist-backend" user (read-only on its own queue)
RABBITMQ_GAMELIST_BACKEND_PASSWORD=
# Host directory containing cert.pem/key.pem/ca.pem for the AMQPS listener.
# For local dev, point this at ./rabbitmq/tls-dev (a throwaway, already-committed self-signed cert).
# In production, point it at a real cert/key issued for this host - this repo does not issue one.
RABBITMQ_TLS_DIR=./rabbitmq/tls-dev

# Keycloak SPI config for the deletion-event-publisher extension (Deletion Broker connection)
KC_SPI_EVENTS_LISTENER_DELETION_EVENT_PUBLISHER_HOST=rabbitmq
KC_SPI_EVENTS_LISTENER_DELETION_EVENT_PUBLISHER_PORT=5672
KC_SPI_EVENTS_LISTENER_DELETION_EVENT_PUBLISHER_VIRTUAL_HOST=/
KC_SPI_EVENTS_LISTENER_DELETION_EVENT_PUBLISHER_USERNAME=keycloak-deletion-publisher
# Same value as RABBITMQ_KEYCLOAK_PUBLISHER_PASSWORD above
KC_SPI_EVENTS_LISTENER_DELETION_EVENT_PUBLISHER_PASSWORD=
KC_SPI_EVENTS_LISTENER_DELETION_EVENT_PUBLISHER_EXCHANGE=user-deletion
